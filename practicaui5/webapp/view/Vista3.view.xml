<mvc:View controllerName="practicaui5.practicaui5.controller.vista3"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page id="vista3" title="Gestión de Permisos">
            <OverflowToolbar id="headerToolbar3" style="Clear">
            <ToolbarSpacer id="spacer3" />
                <Button id="GuardarDatos" text="GuardarDatos" icon="sap-icon://upload" press="GuardarDatos" type="Emphasized" />
        </OverflowToolbar>

        <Table id="idTablaPermisos" items="{permisosModel>/}">
            <columns>
                <Column id="columna">
                    <Text id="colNombre" text="Nombre" />
                </Column>
                <Column id="Columna2">
                    <Text id="textoUser" text="Usuario" />
                </Column>
                <Column id="columna3">
                    <Text id="textoPermiso" text="Permiso" />
                </Column>
            </columns>
            <items>
                <ColumnListItem id="colItem">
                    <cells>
                        <Text id="name1" text="{permisosModel>Name}" />
                        <Text id="name2" text="{permisosModel>U_User}" />
                        
                        <Select id="selectPermisos" 
                                width="100%" 
                                selectedKey="{permisosModel>U_Permisos}">
                            <items>
                                <core:Item id="adminO" key="admin" text="Admin" />
                                <core:Item id="userO" key="user" text="Usuario" />
                                <core:Item id="editorO" key="editor" text="Editor" />
                            </items>
                        </Select>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>
