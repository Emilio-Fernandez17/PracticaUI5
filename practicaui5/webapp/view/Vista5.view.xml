<mvc:View controllerName="practicaui5.practicaui5.controller.vista5"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page5" title="{i18n>pedidos}" showNavButton="true" navButtonPress="volverAPrincipal">
        <headerContent>
            <Button id="botonIdiomas5" text="{i18n>Idioma}" icon="sap-icon://world" press="onButtonPress" type="Transparent" />
        </headerContent>

        <Table id="idTablapPedidos" width="auto" items="{pedidos>/value}" class="sapUiResponsiveMargin" growing="true" growingThreshold="20" sticky="HeaderToolbar,ColumnHeaders">
            <headerToolbar>
                <OverflowToolbar id="otbTablePedido" design="Transparent">
                    <Title id="tableTitlePedido" text="{i18n>tituloTablaPedidos}" level="H2" />
                    <ToolbarSpacer id="spacerTablePedido" />
                </OverflowToolbar>
            </headerToolbar>

            <columns>
                <Column id="colNEntrada" width="8rem" hAlign="Begin">
                    <header><Text id="txtColNEntrada" text="Nº {i18n>entrada}" /></header>
                </Column>
                <Column id="colProveedor" minScreenWidth="Tablet" demandPopin="true">
                    <header><Text id="txtColProveedor" text="{i18n>interlocutor}" /></header>
                </Column>
                <Column id="colEstado" hAlign="Center" width="8rem">
                    <header><Text id="txtColEstado" text="{i18n>estado}" /></header>
                </Column>
                <Column id="colFecha" hAlign="Center" width="10rem">
                    <header><Text id="txtColFecha" text="{i18n>fecha}" /></header>
                </Column>
                <Column id="colTipo" hAlign="Center" width="8rem">
                    <header><Text id="txtColTipo" text="{i18n>tipo}" /></header>
                </Column>
                <Column id="colTotal" hAlign="End">
                    <header><Text id="txtColTotal" text="Total" /></header>
                </Column>
            </columns>

            <items>
                <ColumnListItem id="idFilaPedido" vAlign="Middle" type="Active">
                    <cells>
                        <ObjectStatus id="objIdPedido" title="{pedidos>DocEntry}" icon="sap-icon://primary-key" />
                        <ObjectStatus id="txtProvPedido" text="{pedidos>CardCode}" icon="sap-icon://person-placeholder" />
                        <ObjectStatus id="statEstadoPedido" text="{i18n>cerrado}" state="None" icon="sap-icon://locked" />
                        <ObjectStatus id="txtFechaPedido" text="{path: 'pedidos>CreateDate', formatter: '.formatearFecha'}" state="None" icon="sap-icon://calendar"/>
                        <ObjectStatus id="statTipoPedido" text="{= ${pedidos>Tipo} === 'Compra' ? ${i18n>compra} : ${i18n>venta} }" state="{= ${pedidos>Tipo} === 'Compra' ? 'Indication03' : 'Indication05' }" />

                        <ObjectNumber id="numTotalPedido" number="{path: 'pedidos>DocTotal',type: 'sap.ui.model.type.Float',formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 }}" unit="€" state="Information" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>