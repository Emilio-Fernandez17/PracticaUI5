<mvc:View controllerName="practicaui5.practicaui5.controller.PracticaUI5"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:suite="sap.suite.ui.commons"
    xmlns:u="sap.ui.unified">
    <Page id="page" title="{i18n>title}">

        <OverflowToolbar id="headerToolbar" style="Clear">
            <ToolbarSpacer id="spacer" />
            <Button id="sqlquery" text="{i18n>pedidos}" press="navegar3" type="Accept" icon="sap-icon://documents"></Button>
            <Button id="batch" text="{i18n>empleados}" press="navegar2" type="Unstyled" class="miBotonPersonalizado" visible="{usuario>/esEditor}"></Button>
            <Button id="roles" text="{i18n>roles}" press="navegar" visible="{usuario>/esAdmin}" icon="sap-icon://journey-change" type="Neutral"></Button>
            <Button id="btnUsuario" text="{usuario>/nombre}" icon="sap-icon://person-placeholder" type="Emphasized"/>
            <Button id="btn2" text="{i18n>vista}" press="cambiarRuta" icon="sap-icon://addresses" type="Ghost"/>
            <Button id="botonIdiomas" text="{i18n>Idioma}" icon="sap-icon://world" press="onButtonPress" type="Transparent" />
        </OverflowToolbar>


        <HBox id="layoutHorizontal" width="100%" alignItems="Stretch">
            <items>
                <VBox id="contenedorLista" width="100%">
                    <layoutData>
                        <FlexItemData id="flexDataLista" baseSize="30%" />
                    </layoutData>
                    <items>
                        <tnt:NavigationList id="navigationList" width="100%" >
                            <tnt:NavigationListItem id="cabecera" text="{i18n>Cabecera}" icon="sap-icon://list" items="{path: '/BusinessPartners', startIndex: 0, length: 20}">
                                <tnt:NavigationListItem id="navigationItem" text="{CardCode}" key="{CardCode}" />
                            </tnt:NavigationListItem>
                        </tnt:NavigationList>
                    </items>
                </VBox>

                <VBox id="contenedorGrafica" width="100%">
                    <layoutData>
                        <FlexItemData id="flexDataGrafica" growFactor="1" baseSize="70%" />
                    </layoutData>
                    <items>
                        <suite:ChartContainer id="chartContainer" showFullScreen="true" title="{i18n>Grafica}">
                            <suite:content>
                                <suite:ChartContainerContent id="chartContentGrafica" icon="sap-icon://line-chart" title="Line Chart">
                                    <suite:content>
                                        <viz:VizFrame id="chartContainerVizFrame" height="720px" width="100%" uiConfig="{applicationSet:'fiori'}"></viz:VizFrame>
                                    </suite:content>
                                </suite:ChartContainerContent>
                            </suite:content>
                        </suite:ChartContainer>
                    </items>
                </VBox>
        </items>
    </HBox>

        <Text id="a" text="&#10;"/>
        <Table id="idTablaPrueba" width="95%"  items="{Items>/value}" class="sapUiMediumMarginTop sapUiResponsiveMargin" visible="{usuario>/esEditor}" growing="true">
            <headerToolbar>
                <OverflowToolbar id="otbTable">
                    <Title id="tableTitle" text="{i18n>titleTable}" level="H2" />
                    <ToolbarSpacer id="spacerTable" />
                    <Button id="anadeArticuloTable" text="{i18n>abrirFormulario}" icon="sap-icon://add" type="Emphasized" press="anadir" visible="{usuario>/esEditor}"/>
                </OverflowToolbar>
            </headerToolbar>
            <columns>
                <Column id="colCode"><header><Text id="txtColCode" text="{i18n>ItemCode}"/></header></Column>
                <Column id="colName"><header><Text id="txtColName" text="{i18n>ItemName}" /></header></Column>
                <Column id="colSerie" hAlign="Center"><header><Text id="txtColSerie" text="{i18n>ItemSerie}" /></header></Column>
                <Column id="colLote" hAlign="Center"><header><Text id="txtColLote" text="{i18n>ItemLote}" /></header></Column>
                <Column id="colAlmacenado" hAlign="End"><header><Text id="txtColStock" text="{i18n>stock}" /></header></Column>
                <Column id="colAcciones" hAlign="End" width="8rem"><header><Text id="txtColAcciones" text="{i18n>acciones}" /></header></Column>
                <Column id="colEditor"><header><Text id="colUsuario" text="{i18n>editado}"/></header></Column>
            </columns>
            <items>
                <ColumnListItem id="idFila1">
                    <cells>
                        <ObjectStatus id="txtCellCode" text="{Items>ItemCode}" icon="sap-icon://primary-key"/>
                        <ObjectStatus id="txtCellName" text="{Items>ItemName}" icon="sap-icon://message-information" />
                        <ObjectStatus id="txtCellSerie" icon="sap-icon://settings" text="{parts: [{path: 'Items>ManageSerialNumbers'},{path: 'formulario>/idiomaActual'}],formatter: '.formatearSiNo'}" />
                        <ObjectStatus icon="sap-icon://settings" id="txtCellLote" text="{parts: [{path: 'Items>ManageBatchNumbers'},{path: 'formulario>/idiomaActual'}],formatter: '.formatearSiNo'}" />
                        <ObjectStatus id="stock" text="{Items>QuantityOnStock} {i18n>unidades}" icon="sap-icon://factory"/> 
                        <HBox id="hbAcciones" justifyContent="End">
                            <Button id="btnEditarFila" icon="sap-icon://edit" type="Transparent" press="editar" class="sapUiTinyMarginEnd" visible="{usuario>/esEditor}" />
                            <Button id="btnBorrarFila" icon="sap-icon://delete" type="Reject" press="borrar" visible="{usuario>/esEditor}" />
                        </HBox>
                        <ObjectStatus icon="sap-icon://account" id="txtUsuario" text="{Items>U_UsuarioEditor}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <HBox justifyContent="Center" width="100%" id="hoboxBotones">
            <Button id="atras" visible="{usuario>/esEditor}" icon="sap-icon://arrow-left" enabled="false" press="atras"/>
            <Button id="delante" icon="sap-icon://arrow-right" visible="{usuario>/esEditor}" press="delante" enabled="false"/>
        </HBox>


        <VBox id="wrapperFormularioPermisos" visible="{usuario>/esEditor}">
            <Panel id="panelFormulario" width="95%" visible="{formulario>/formulario}" class="sapUiMediumMarginTop sapUiResponsiveMargin" accessibleRole="Region">
                <headerToolbar>
                    <OverflowToolbar id="otbForm">
                        <Title id="titleForm" text="{i18n>tituloDetalle}" />
                    </OverflowToolbar>
                </headerToolbar>
                <content>
                    <f:SimpleForm id="simpleFormArticulo" editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1">
                        <f:content>
                            <Label id="lblCode" text="{i18n>formCode}" />
                            <MultiInput id="vCode" editable="false" placeholder="Introduce el codigo..." />
    
                            <Label id="lblName" text="{i18n>formName}" />
                            <MultiInput id="vName" placeholder="Introduce el nombre..."/>
    
                            <Label id="lblSerie" text="{i18n>formSerie}" />
                            <Select id="serie" enabled="{formulario>/cantidad}" change="mostrarlote" width="100%">
                                <items>
                                    <core:Item id="serieS" key="S" text="{i18n>si}" />
                                    <core:Item id="serieN" key="N" text="{i18n>no}" />  
                                </items>
                            </Select>
    
                            <Label id="lblLote" text="{i18n>formLote}" visible="{formulario>/lote}" />
                            <Select id="lote" enabled="{formulario>/cantidad}" visible="{formulario>/lote}" width="100%">
                                <items>
                                    <core:Item id="loteN" key="N" text="{i18n>no}" />
                                    <core:Item id="loteS" key="S" text="{i18n>si}" />
                                </items>
                            </Select>
    
                            <Label id="lblRepeticion" text="{i18n>repeticion}" visible="{formulario>/repeticion}" />
                            <Text id="txtRepeticion" text=":" visible="{formulario>/repeticion}" />
    
                            <Label id="lblSpacer" text="" />
                            <HBox id="hboxBotonesForm" class="sapUiSmallMarginTop">
                                <Button id="Anade" text="{i18n>abrirFormulario}" icon="sap-icon://sys-add" type="Accept" press="anadeArticulo" visible="{formulario>/anade}" class="sapUiTinyMarginEnd" />
                                <Button id="Edita" text="{i18n>EditarBoton}" icon="sap-icon://edit" type="Accept" press="EditaArticulo" visible="{formulario>/editar}" class="sapUiTinyMarginEnd" />
                                <Button id="cancelar" text="{i18n>CancelarBoton}" type="Back" press="ocultarFormulario" />
                            </HBox>
                        </f:content>
                    </f:SimpleForm>
                </content>
            </Panel>
        </VBox>

        <Panel id="panelGestionFotos" headerText="{i18n>gestionFotos}" width="95%" class="sapUiMediumMarginTop sapUiResponsiveMargin" visible="{usuario>/esAdmin}">
            <content>
                <f:SimpleForm id="formSubidaFotos" editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" columnsL="1" columnsM="1">
                    <f:content>
                        <Label id="TextoEmpleados" text="{i18n>seleccionarEmp}" />
                        <Select id="select" items="{/EmployeesInfo}" width="100%" forceSelection="false">
                            <core:Item id="option" key="{EmployeeID}" text="{FirstName} {LastName}"/>
                        </Select>


                        <Label id="lblArchivo" text="{i18n>imagen}" />
                        <u:FileUploader id="subirFoto" name="file" fileType="jpg,jpeg,png" change="cargar" placeholder="{i18n>seleccionarImg}" style="Emphasized" width="100%" />

                        <Label id="label1" text="" />
                        <Button id="BotonSubir" text="{i18n>botonImg}" icon="sap-icon://upload" press="subirFotoEmpleado" type="Emphasized">
                            <layoutData>
                                <layout:GridData  id="layout1" span="L4 M4 S12" />
                            </layoutData>
                        </Button>
                    </f:content>
                </f:SimpleForm>
            </content>
        </Panel>

    </Page>
</mvc:View>
