                            <Label id="lblApellidos1" text="Apellidos" required="true" labelFor="ia1"/>
                            <Input id="ia1" placeholder="Introduce apellidos..." class="sapUiTinyMarginBottom"/>
                            <Label id="lblTrabajo1" text="Trabajo" labelFor="it1"/>
