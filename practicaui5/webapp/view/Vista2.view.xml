<mvc:View controllerName="practicaui5.practicaui5.controller.vista2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form">
    <Page id="page2" showHeader="false" backgroundDesign="Solid">
        <content>
            <OverflowToolbar id="headerToolbar2" style="Clear">
                <ToolbarSpacer id="spacer2" />
                <Button id="botonIdiomas2" text="{i18n>Idioma}" icon="sap-icon://world" press="onButtonPress" type="Transparent" />
            </OverflowToolbar>

            <FlexBox id="vboxCentrado" alignItems="Center" justifyContent="Center" height="90%" direction="Column">

                <Panel id="panelLogin" width="420px" backgroundDesign="Solid" class="sapUiShadowLevel2 sapUiResponsiveMargin">
                    <headerToolbar>
                        <Toolbar id="tbLogin" style="Clear" height="80px">
                            <ToolbarSpacer id="toolbar23"/>
                            <FlexBox direction="Column" alignItems="Center" justifyContent="Center" id="flexbox">
                                <Avatar id="loginAvatar" backgroundColor="Accent6" class="sapUiTinyMarginBottom" />
                                <Title id="txtTitle" text="{i18n>inicioSesion}" level="H4" class="sapUiSmallMarginBottom" />
                            </FlexBox>
                            <ToolbarSpacer id="toolbar"/>
                        </Toolbar>
                    </headerToolbar>

                    <content>
                        <VBox id="vboxCampos" class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom">

                            <Label id="lblNombre" text="{i18n>nombre}" labelFor="inputNombre" class="sapUiTinyMarginTop" />
                            <Input id="inputNombre" type="Text" placeholder="{i18n>Pnombre}" width="100%" showValueStateMessage="true"/>

                            <Label id="lblPassword" text="{i18n>contrasena}" labelFor="inputPassword" class="sapUiSmallMarginTop" />
                            <Input id="inputPassword" type="Password" placeholder="••••••••"width="100%" />
                                
                            <Button id="btnEnviar" text="{i18n>enviar}" type="Emphasized" press="login" width="100%" icon="sap-icon://log" class="sapUiMediumMarginTop" />
                        </VBox>
                    </content>
                </Panel>
            </FlexBox>
        </content>
    </Page>
</mvc:View>